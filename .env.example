# VeriCare AI - Environment Configuration Template
# Academic prototype - placeholders only

ENVIRONMENT=development
PROJECT_NAME="VeriCare AI"
API_V1_STR=/api/v1

# MongoDB Connection (Async Motor)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=vericare_db

# Security & JWT (Change secret key in production)
JWT_SECRET_KEY=change-this-to-a-secure-secret-key-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Aria Adapter Configuration (External Service Boundary)
ARIA_SERVICE_URL=http://localhost:8001
